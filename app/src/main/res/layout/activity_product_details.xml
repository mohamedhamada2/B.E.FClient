<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:fitsSystemWindows="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".productDetails.ProductDetailsActivity"
    android:background="#FAFAFA">
    <RelativeLayout
        android:id="@+id/relative1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_70sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <TextView
            android:id="@+id/txt_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/back_img"
            android:layout_toRightOf="@+id/basket_card"
            android:textSize="@dimen/_18ssp"
            android:fontFamily="@font/dinnextextbold2"
            android:textColor="#202020"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/back_img"
            android:layout_width="@dimen/_48sdp"
            android:layout_height="@dimen/_48sdp"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:background="@drawable/back_icon"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/basket_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardElevation="@dimen/_5sdp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            app:cardCornerRadius="@dimen/_30sdp"
            android:layout_margin="@dimen/_10sdp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ic_cart_icon"
                android:layout_margin="@dimen/_5sdp"/>
            <TextView
                android:id="@+id/txt_basket"
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:background="@drawable/circle"
                android:layout_margin="@dimen/_5sdp"
                android:textSize="@dimen/_8ssp"
                android:fontFamily="@font/dinnextextbold2"
                android:textColor="@color/white"
                android:text="0"
                android:gravity="center"/>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/relative1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_5sdp">
            <!-- Same content as the product details dialog; its cancel button is hidden in code -->
            <include
                android:id="@+id/product_details_content"
                layout="@layout/product_details_dialog"/>
        </FrameLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
